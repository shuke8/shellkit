#!/usr/bin/env node
// Turn text into a URL slug, including Cyrillic input.
'use strict';

const CYRILLIC = {
  а: 'a', б: 'b', в: 'v', г: 'g', д: 'd', е: 'e', ё: 'e', ж: 'zh', з: 'z', и: 'i',
  й: 'y', к: 'k', л: 'l', м: 'm', н: 'n', о: 'o', п: 'p', р: 'r', с: 's', т: 't',
  у: 'u', ф: 'f', х: 'h', ц: 'ts', ч: 'ch', ш: 'sh', щ: 'sch', ъ: '', ы: 'y',
  ь: '', э: 'e', ю: 'yu', я: 'ya', ў: 'o', қ: 'q', ғ: 'g', ҳ: 'h', і: 'i', ї: 'yi', є: 'ye',
};

function usage() {
  console.log(`sk-slug — turn text into a URL slug

Usage:
  sk-slug <text...>
  echo "text" | sk-slug

Latin diacritics are folded, Cyrillic is transliterated, everything else becomes
a single hyphen.

Example:
  sk-slug "Доставка дверей — Москва"   # dostavka-dverey-moskva`);
}

function slugify(input) {
  return input
    .toLowerCase()
    // Decompose so a combining accent can be dropped without a per-letter table.
    .normalize('NFKD')
    .replace(/[̀-ͯ]/g, '')
    .replace(/[Ѐ-ӿ]/g, (char) => (char in CYRILLIC ? CYRILLIC[char] : ''))
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-+|-+$/g, '');
}

const args = process.argv.slice(2);
if (args[0] === '--help' || args[0] === '-h') {
  usage();
  process.exit(0);
}

if (args.length) {
  console.log(slugify(args.join(' ')));
} else if (process.stdin.isTTY) {
  usage();
  process.exit(1);
} else {
  let input = '';
  process.stdin.on('data', (chunk) => { input += chunk; });
  process.stdin.on('end', () => {
    for (const line of input.split('\n')) {
      if (line.trim()) console.log(slugify(line));
    }
  });
}

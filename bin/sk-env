#!/usr/bin/env node
// Compare a .env against its template, and refuse to print secret values.
'use strict';

const fs = require('fs');

function usage() {
  console.log(`sk-env — compare a .env file against its template

Usage:
  sk-env [--env <file>] [--template <file>]

Options:
  --env <file>       defaults to .env
  --template <file>  defaults to .env.example, then .env.template

Reports keys the template requires but the env is missing, keys the env defines
that the template does not document, and keys whose value is still empty.
Values are never printed.

Example:
  sk-env --env .env.production`);
}

const argv = process.argv.slice(2);
if (argv.includes('--help') || argv.includes('-h')) {
  usage();
  process.exit(0);
}

function flag(name, fallbacks) {
  const index = argv.indexOf(name);
  if (index !== -1) return argv[index + 1];
  return fallbacks.find((candidate) => fs.existsSync(candidate));
}

const envFile = flag('--env', ['.env']);
const templateFile = flag('--template', ['.env.example', '.env.template']);

if (!envFile || !fs.existsSync(envFile)) {
  console.error(`env file not found: ${envFile || '.env'}`);
  process.exit(1);
}
if (!templateFile || !fs.existsSync(templateFile)) {
  console.error('no template found — pass --template, or add .env.example');
  process.exit(1);
}

// Keys only. The value side of an env file is exactly what must not end up in a
// terminal, a log or a screenshot.
function parse(file) {
  const entries = new Map();
  for (const raw of fs.readFileSync(file, 'utf8').split('\n')) {
    const line = raw.trim();
    if (!line || line.startsWith('#')) continue;
    const eq = line.indexOf('=');
    if (eq === -1) continue;
    entries.set(line.slice(0, eq).trim(), line.slice(eq + 1).trim());
  }
  return entries;
}

const env = parse(envFile);
const template = parse(templateFile);

const missing = [...template.keys()].filter((key) => !env.has(key));
const extra = [...env.keys()].filter((key) => !template.has(key));
const empty = [...env.entries()].filter(([, value]) => value === '' || value === '""').map(([key]) => key);

for (const key of missing) console.log(`missing    ${key}`);
for (const key of empty) console.log(`empty      ${key}`);
for (const key of extra) console.log(`undocumented ${key}`);

console.log(`\n${env.size} keys in ${envFile} · ${missing.length} missing · ${empty.length} empty · ${extra.length} undocumented`);
process.exit(missing.length || empty.length ? 1 : 0);
